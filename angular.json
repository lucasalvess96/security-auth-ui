{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "security-auth-ui": {
      "projectType": "library",
      "root": "projects/security-auth-ui",
      "sourceRoot": "projects/security-auth-ui/src",
      "prefix": "security-auth",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": { "project": "projects/security-auth-ui/ng-package.json", "tsConfig": "projects/security-auth-ui/tsconfig.lib.json" }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/security-auth-ui/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"],
            "styles": [], "scripts": [], "assets": []
          }
        }
      }
    }
  }
}
